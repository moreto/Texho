		<function name="updatedat" id="029c653a-7214-455d-8af6-20425371102e" isSystem="false" params_known="n" >
			<string><![CDATA[CREATE OR REPLACE FUNCTION public.updatedat()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN
    NEW.updated_at = CURRENT_TIMESTAMP;
    RETURN NEW;
END;
$function$;]]></string>
		</function>
		<trigger name="trgupdateat" table="empresa" id="9de9981b-5854-4da5-83b9-785f2293e93c" isSystem="false" >
			<string><![CDATA[CREATE TRIGGER ${name} BEFORE UPDATE ON public.empresa FOR EACH ROW EXECUTE FUNCTION updatedat()]]></string>
		</trigger>
		<trigger name="trgupdateat" table="traducao" id="a8f9f5f3-f0a5-47a7-92c2-985ce2f4b16e" isSystem="false" >
