		</trigger>
		<trigger name="trgupdateat" table="usuario" id="098f49a6-fe60-47e0-94f5-690eff51fa93" isSystem="false" >
			<string><![CDATA[CREATE TRIGGER ${name} BEFORE UPDATE ON public.usuario FOR EACH ROW EXECUTE FUNCTION updatedat()]]></string>
		</trigger>
		<trigger name="trgupdateat" table="usuario_otp" id="c59b1080-0ca4-4c5d-9046-849473bcc167" isSystem="false" >
